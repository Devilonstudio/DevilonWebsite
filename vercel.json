{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/og-image.png", "dest": "/frontend/og-image.png" },
    { "src": "/robots.txt", "dest": "/frontend/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/frontend/sitemap.xml" },
    { "src": "/light.png", "dest": "/frontend/light.png" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/$1", "continue": true },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}